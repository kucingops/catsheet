<Project>
  <!-- Central Package Management: versi NuGet ditulis sekali di sini
       (mirip <dependencyManagement> / BOM di Maven). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- test -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
  </ItemGroup>
</Project>
